apiVersion: apps/v1
kind: Deployment
metadata:
  name: repointel-backend
  namespace: repointel
spec:
  replicas: 3
  selector:
    matchLabels:
      app: repointel-backend
  template:
    metadata:
      labels:
        app: repointel-backend
    spec:
      containers:
      - name: backend
