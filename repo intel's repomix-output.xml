ta[\"name\"], data[\"price\"], data.get(\"category\", \"general\"))\n\n    def to_dict(self):\n        \"\"\"Serialize product.\"\"\"\n        return {\"sku\": self.sku, \"name\": self.name,\n                \"price\": self.price, \"category\": self.category}", "score": 0.013}, {"id": "d261028dc08e2aff", "file": "demo_shop/models.py", "lines": "24-33", "content": "class User:\n    \"\"\"A shop user with a role.\"\"\"\n\n    def __init__(self, username, role=\"user\"):\n        self.username = username\n        self.role = role\n\n    def to_dict(self):\n        \"\"\"Serialize user.\"\"\"\n        return {\"username\": self.username, \"role\": self.role}", "score": 0.013}, {"id": "d400c2b6054a4eb4", "file": "demo_shop/models.py", "lines": "1-3", "content": "\"\"\"Data models for demo-web-shop.\"\"\"\n\n", "score": 0.013}, {"id": "f120bb32d3f1f32b", "file": "demo_shop/utils.py", "lines": "5-10", "content": "def calculate_total(items):\n    \"\"\"Sum item prices.\"\"\"\n    total = 0\n    for entry in items:\n        total += entry[\"product\"].price * entry[\"quantity\"]\n    return total", "score": 0.012}, {"id": "9cc615dbf4ea9c57", "file": "demo_shop/utils.py", "lines": "13-15", "content": "def format_currency(amount):\n    \"\"\"Format a currency amount.\"\"\"\n    return \"$\" + f\"{amount:,.2f}\"", "score": 0.012}, {"id": "114ecdaffc9a16f4", "file": "demo_shop/utils.py", "lines": "18-23", "content": "def parse_config(raw):\n    \"\"\"Parse JSON config, tolerating bad input.\"\"\"\n    try:\n        return json.loads(raw)\n    except ValueError:\n        return {}", "score": 0.012}, {"id": "ad720bd9b41ebc4c", "file": "demo_shop/utils.py", "lines": "26-34", "content": "def slugify(text):\n    \"\"\"Convert text to slug.\"\"\"\n    out = []\n    for ch in text.lower():\n        if ch.isalnum():\n            out.append(ch)\n        elif ch in (\" \", \"-\", \"_\"):\n            out.append(\"-\")\n    return \"\".join(out).strip(\"-\")", "score": 0.012}, {"id": "b48c