# ICE local environment template.
# Copy this file to .env and replace placeholders. Never commit .env or keys.

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ice_cognitive
# Docker Compose uses the service name "postgres"; local scripts use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ice_cognitive
# asyncpg pool bounds per process (raise DB_POOL_MAX for concurrent load).
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── LLM providers (at least one is needed for LLM-backed flows) ────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
LLM_FALLBACK_CHAIN=
STAGE1_FALLBACK_3=mistral/mistral-small-latest
LITELLM_NETWORK_TIMEOUT=15
EMBEDDING_MODEL=gemini-embedding-2

# Role-based routing: comma-separated model lists; empty uses the fallback chain.
LLM_ROLE_GENERATOR=
LLM_ROLE_CRITIC=
LLM_ROLE_RANKER=
LLM_ROLE_EXTRACTOR=

# ── Optional evidence integrations ─────────────────────────────────────────
# local = httpx + trafilatura (no key, default) | scrapfly | firecrawl (JS-heavy pages)
SCRAPER=local
# Keyless web research for natural-language SEARCH actions (DuckDuckGo via ddgs,
# GitHub repository search). 0 disables every outbound lookup.
ICE_WEB_RESEARCH=1
ICE_WEB_TIMEOUT=15
# Optional: raises the GitHub search rate limit.
GITHUB_TOKEN=
SCRAPFLY_API_KEY=
FIRECRAWL_API_KEY=
DOCLING_ENABLED=true

# ── API / UI ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501
# Use 8001 when RepoIntel runs on the same machine (RepoIntel owns 8000).
API_BASE_URL=http://localhost:8000/api/v1

# ── RepoIntel integration ──────────────────────────────────────────────────
# HTTP base URL of the RepoIntel API (MCP bridge: MCP -> REST -> SQLite fallback).
REPOINTEL_URL=http://localhost:8000
# RepoIntel knowledge base, opened READ-ONLY. REPOINTEL_DB wins; otherwise
# REPOINTEL_DIR, then the sibling checkout ../../repointel-ai-2 are searched.
REPOINTEL_DB=
REPOINTEL_DIR=
# Seconds to wait on a RepoIntel writer lock before a read fails.
REPOINTEL_DB_TIMEOUT=5
# Autonomy Dial 0-10 (case_engine/action.py): gates auto-approve / auto-execute
# of actions, including RepoIntel-backed ones. 0 = everything needs approval.
# AUTONOMY_LEVEL >= 1 allows LAB_PROPOSE actions to submit sandbox Lab proposals
# (applying edits to repo files always remains human-approved).
AUTONOMY_LEVEL=0
# Optional Semantic Scholar Graph API key (cross-domain discovery works keyless too).
SEMANTIC_SCHOLAR_API_KEY=

# ── ICE reasoning feature flags ────────────────────────────────────────────
ENABLE_CONTRADICTIONS=true
ENABLE_HYPOTHESIS_VERSIONING=true
ENABLE_SOURCE_INDEPENDENCE=true
ENABLE_REPLAY=true
ENABLE_FALSIFICATION_LOOP=false
ENABLE_NEXT_BEST_EVIDENCE=true
ENABLE_LLM_LEDGER=true
ICE_CONSOLIDATED_CYCLE=false
ICE_CYCLE_INDUCTION=false
ICE_CYCLE_WORKSPACE=false
ENABLE_BACKGROUND_CASE_REVIEW=true

# ── Reproducibility / legacy substrate ─────────────────────────────────────
EXPERIMENT_SEED=
VOICE_BACKEND=legacy
# Set to true only when intentionally exercising the legacy substrate.
ENABLE_PRM=false

# Extra KEY=VALUE files loaded at API/MCP startup (';' separated). Existing
# environment variables win. Example: reuse RepoIntel's LLM provider keys.
ICE_ENV_FILES=

# --- Local models, learned routing, cross-domain discovery (2026-11-28, 2nd pass) ---
# Embeddings: one backend per database (vectors from different models are not
# comparable). After switching, run: python scripts/reembed_evidence.py
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Load the local embedder at start-up instead of on the first search.
ICE_WARM_EMBEDDER=1
# Local LLM appended LAST to the provider chain when it answers (workspace Ollama).
LOCAL_LLM_FALLBACK=1
LOCAL_LLM_MODEL=ollama_chat/qwen2.5:3b
OLLAMA_API_BASE=http://127.0.0.1:11435
# SEARCH routing: learned semantic router first, keyword cues as the fallback.
ICE_SEMANTIC_ROUTER=1
ROUTER_MIN_MARGIN=0.015
ICE_ROUTER_STATE=
# Research questions: diverse cross-domain fields instead of fixed lens templates.
ICE_CROSS_DOMAIN_QUESTIONS=1
# Discovery: structural fingerprint cache, field bandit state, optional OpenAlex key.
ICE_FINGERPRINT_INDEX=
ICE_DISCOVERY_STATE=
OPENALEX_API_KEY=
# Stalled goals (two code checks without improvement) get discovery automatically:
# auto = only when AUTONOMY_LEVEL >= 1; force = always; 0 = never.
ICE_AUTO_DISCOVERY=auto
ICE_AUTO_DISCOVERY_COOLDOWN_H=24
